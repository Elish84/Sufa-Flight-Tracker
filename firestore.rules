rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== פונקציות עזר =====
    function signedIn() {
      return request.auth != null;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isDivision() {
      return signedIn() && request.auth.token.email == 'shomron@gmail.com';
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isManager() {
      return signedIn() &&
        exists(/databases/$(database)/documents/manager/$(request.auth.uid));
    }

    function isDeveloper() {
      return signedIn() &&
        exists(/databases/$(database)/documents/developers/$(request.auth.uid));
    }

    function isAssignedTo(depId) {
      return isAdmin() && 
        get(/databases/$(database)/documents/deploymentsMap/$(request.auth.token.email.lower())).data.deployment == depId;
    }

    function isOwner() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function isCreatingOwnRecord() {
      return signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    // =====================================================
    // ============ PROJECT: DEPLOYMENTS (V5) ==============
    // =====================================================
    
    match /deployments/{depId}/reviews/{docId} {
      allow create: if isAdmin();
      allow read: if isDivision() || isAssignedTo(depId);
      allow update, delete: if isAdmin() && isAssignedTo(depId);
    }

    match /{path=**}/reviews/{docId} {
      allow read: if isDivision() || isAdmin();
    }

    // =====================================================
    // ============ PROJECT: SECTOR EVENTS =================
    // =====================================================
    match /sectorEvents/{docId} {
      allow create: if true;
      allow read: if signedIn();
      allow update, delete: if isAdmin() || isManager();
    }

    match /roles/{docId} {
      allow read: if true;
      allow create, update, delete: if isManager();
    }

    match /eventTypes/{docId} {
      allow read: if true;
      allow create, update, delete: if isManager();
    }

    // =====================================================
    // ================= PROJECT: REVIEWS ==================
    // =====================================================
    match /reviews/{docId} {
      allow create: if signedIn();
      allow read: if isAdmin() || isDivision();
      allow update, delete: if isAdmin();
    }

    // =====================================================
    // ============== PROJECT: HOUSE SCANS =================
    // =====================================================
    match /houseScans/{docId} {
      allow create: if true;
      allow read: if isAdmin() || isDivision();
      allow update, delete: if isAdmin();
    }

    // =====================================================
    // =================== MAP PINS ========================
    // =====================================================
    match /mapPins/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // =====================================================
    // =================== PLACES ==========================
    // =====================================================
    match /places/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // =================== SECTORS =========================
    // =====================================================
    match /sectors/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isManager();
    }

    // =====================================================
    // ================= TZAMM CALENDAR ====================
    // =====================================================
    match /tzammCalendar/{docId} {
      allow read: if true;
      allow create, update: if true;
    }

    // =====================================================
    // =================== ADMINS ==========================
    // =====================================================
    match /admins/{uid} {
      allow read: if isAuthenticated();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if isAdmin();
    }

    match /deploymentsMap/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // =====================================================
    // ================== MANAGER =========================
    // =====================================================
    match /manager/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && request.auth.uid == uid;
      allow update, delete: if isManager();
    }

    // =====================================================
    // ================= DEVELOPERS =======================
    // =====================================================
    match /developers/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && request.auth.uid == uid;
      allow update, delete: if isDeveloper();
    }

    // =====================================================
    // =================== SETTINGS ========================
    // =====================================================
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isDeveloper();
    }

    // =====================================================
    // ============ PROJECT: OBSERVATION OWL ===============
    // =====================================================
    match /formTypes/{docId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    match /observationPosts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /frameworks/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /observationTrainingReports/{docId} {
      allow create: if true; 
      allow read, update, delete: if isAdmin();
    }

    // =====================================================
    // ============ PROJECT: MAGNIX FLIGHT TRACKER =========
    // =====================================================
    match /magnix_flightLogs/{docId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn();
    }
    
    match /magnix_units/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /magnix_malfunctionTypes/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /magnix_malfunctionSeverities/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /magnix_admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // =====================================================
    // ============ ORIGINAL SUFA APP RULES ================
    // =====================================================
    match /flightLogs/{flightId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    match /units/{unitId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /malfunctionTypes/{typeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /malfunctionSeverities/{sevId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =====================================================
    // ============ ATP SUFA RULES =========================
    // =====================================================
    match /systemTypes/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /testDefinitions/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /tests/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /atpRecords/{docId} {
      allow create: if isCreatingOwnRecord() || isAdmin();
      allow read: if isAdmin() || isOwner();
      allow update: if isAdmin() || (isOwner() && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin() || isOwner();
    }

    // =====================================================
    // ============ SUFA STATUS RULES (New) ================
    // =====================================================
    match /sufa/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      
      match /drones/{droneId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // =====================================================
    // ============ CATCH-ALL BLOCK ========================
    // =====================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
